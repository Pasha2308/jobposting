{
  "functions": {
    "src/pages/api/telegram/portfolio-webhook.ts": {
      "maxDuration": 60
    },
    "src/pages/api/admin/opportunities/**/*.ts": {
      "maxDuration": 60
    },
    "src/pages/api/cron/retry-retrievals.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/retry-retrievals",
      "schedule": "0 3 * * *"
    }
  ]
}
