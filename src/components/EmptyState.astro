---
import type { IconName } from '../lib/domain/icons';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  icon?: IconName;
}

const { title, description, icon = 'inbox' } = Astro.props;
---

<div class="empty">
  <span class="empty__icon"><Icon name={icon} size={20} /></span>
  <h3>{title}</h3>
  {description && <p>{description}</p>}
  <slot />
</div>
