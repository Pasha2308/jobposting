---
/**
 * Official Hustler Community mark. The source file is the supplied logo PNG,
 * cropped to a square around the mark without recolouring or distortion.
 * See docs/BRAND.md.
 */
interface Props {
  size?: number;
  withText?: boolean;
  href?: string;
  class?: string;
}

const { size = 32, withText = true, href = '/', class: className = '' } = Astro.props;
---

<a href={href} class={`brand ${className}`} aria-label="Hustler Community Opportunities — home">
  <img
    src="/brand/logo-mark.png"
    alt=""
    class="brand__mark"
    width={size}
    height={size}
    style={`height:${size}px;width:${size}px`}
    loading="eager"
    decoding="async"
  />
  {
    withText && (
      <span class="brand__text">
        <span class="brand__name">Hustler Community</span>
        <span class="brand__sub">Opportunities</span>
      </span>
    )
  }
</a>
