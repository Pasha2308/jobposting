---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { loadAdminSettings } from '../../lib/admin-data';
import { configurationReport } from '../../lib/env';

const env = Astro.locals.env;
const settings = await loadAdminSettings(env);
const config = configurationReport(env);
const s = settings.data;

const integrations = [
  {
    name: 'Supabase database',
    ok: config.database,
    env: 'SUPABASE_URL · SUPABASE_SERVICE_ROLE_KEY',
    detail: 'Stores listings, captures, comments, reports and events. Required for the admin workspace.',
  },
  {
    name: 'Supabase Auth',
    ok: config.auth,
    env: 'SUPABASE_ANON_KEY',
    detail: 'Verifies the HttpOnly admin session. Public signup must stay disabled in Supabase.',
  },
  {
    name: env.aiProvider === 'groq' ? 'Groq extraction' : 'Gemini extraction',
    ok: config.ai,
    env: env.aiProvider === 'groq' ? 'GROQ_API_KEY · GROQ_MODEL' : 'GEMINI_API_KEY · GEMINI_MODEL',
    detail: 'Server-side only. Captures are preserved when extraction fails so they can be retried.',
  },
  {
    name: 'Telegram capture bot',
    ok: config.telegram,
    env: 'TELEGRAM_BOT_TOKEN · TELEGRAM_WEBHOOK_SECRET · TELEGRAM_ADMIN_USER_IDS',
    detail: 'Official Bot API webhook. Only allowlisted Telegram user IDs are accepted.',
  },
  {
    name: 'Portfolio discovery and LinkedIn control bot',
    ok: config.portfolioControlBot,
    env: 'PORTFOLIO_TELEGRAM_BOT_TOKEN · PORTFOLIO_TELEGRAM_CHAT_ID · PORTFOLIO_TELEGRAM_WEBHOOK_SECRET',
    detail: 'Separate bot for manual discovery and published-job drafts. The LinkedIn capture bot stays separate.',
  },
  {
    name: 'Cloudflare Turnstile',
    ok: config.turnstile,
    env: 'PUBLIC_TURNSTILE_SITE_KEY · TURNSTILE_SECRET_KEY',
    detail: 'Optional bot protection for public submissions and reports. Honeypot and rate limits still apply.',
  },
];

const setupChecks = [
  { label: 'Database migrations applied', done: config.database },
  { label: 'Public site URL configured', done: Boolean(config.siteUrl) },
  { label: 'Supabase Auth configured', done: config.auth },
  { label: 'AI extraction key present', done: config.ai },
  { label: 'Telegram webhook configured', done: config.telegram },
  { label: 'Portfolio control bot configured', done: config.portfolioControlBot },
  { label: 'Turnstile configured (optional)', done: config.turnstile },
];
---

<AdminLayout
  title="Settings"
  description="Operational settings stored in the database, plus the read-only integration status. Secrets are never displayed or sent to the browser."
  active="settings"
>
  <div slot="actions" class="cluster">
    <a class="btn btn--outline btn--sm" href="/api/health" target="_blank" rel="noopener">
      <Icon name="shield" size={13} /> Health check
    </a>
  </div>

  {!settings.available && (
    <div class="alert alert--warning" role="status" style="margin-bottom:1.5rem">
      <strong>Settings are read-only.</strong> {settings.error} The form below shows the built-in defaults until the
      database is configured.
    </div>
  )}

  <div class="admin-columns">
    <form class="panel" data-settings-form novalidate>
      <div class="panel__head">
        <span class="panel__title"><Icon name="settings" size={14} /> Workspace settings</span>
        <span class="badge badge--draft">Database-backed</span>
      </div>
      <div class="panel__body">
        <div class="form-grid">
          <div class="field col-span-2">
            <label>Site name</label>
            <input class="input" type="text" value={s.site_name} readonly />
            <p class="field__hint">Set through the brand configuration and displayed on the public site.</p>
          </div>
          <div class="field col-span-2">
            <label>Public site URL</label>
            <input class="input" type="text" value={s.site_url} readonly />
            <p class="field__hint">
              Configured with <code>PUBLIC_SITE_URL</code>. Public links, share URLs and Telegram previews use this value.
            </p>
          </div>
          <div class="field">
            <label for="verification_reminder_days">Verification reminder (days)</label>
            <input
              class="input"
              id="verification_reminder_days"
              name="verification_reminder_days"
              type="number"
              min="1"
              max="365"
              step="1"
              value={s.verification_reminder_days}
            />
            <p class="field__hint">How long a published listing can go unchecked before it appears in reminders.</p>
          </div>
          <div class="field">
            <label for="source_retention_days">Source retention (days)</label>
            <input
              class="input"
              id="source_retention_days"
              name="source_retention_days"
              type="number"
              min="7"
              max="3650"
              step="1"
              value={s.source_retention_days}
            />
            <p class="field__hint">Raw capture text is private. Set the retention period you are comfortable with.</p>
          </div>
          <div class="field">
            <label for="default_currency">Default currency</label>
            <input class="input" id="default_currency" name="default_currency" type="text" maxlength="3" value={s.default_currency} />
          </div>
          <div class="field">
            <label for="ai_provider">AI extraction provider</label>
            <select class="select" id="ai_provider" name="ai_provider">
              <option value="groq" selected={s.ai_provider === 'groq'}>Groq</option>
              <option value="gemini" selected={s.ai_provider === 'gemini'}>Gemini</option>
              <option value="none" selected={s.ai_provider === 'none'}>Disabled (manual only)</option>
            </select>
          </div>
          <label class="cluster tiny col-span-2" style="gap:0.5rem;color:var(--text-dim)">
            <input type="checkbox" name="public_submissions_enabled" checked={s.public_submissions_enabled} />
            Accept public submissions (always saved as pending review)
          </label>
          <label class="cluster tiny col-span-2" style="gap:0.5rem;color:var(--text-dim)">
            <input type="checkbox" name="reports_enabled" checked={s.reports_enabled} />
            Accept public reports on live listings
          </label>
        </div>

        <div class="cluster" style="justify-content:flex-end;margin-top:1rem">
          <button class="btn btn--primary btn--sm" type="submit" data-settings-submit>
            <Icon name="check" size={13} /> Save settings
          </button>
        </div>
        <div class="alert alert--success" data-settings-status role="status" aria-live="polite" hidden style="margin-top:0.85rem"></div>
        <div class="alert alert--error" data-settings-error role="alert" hidden style="margin-top:0.85rem"></div>
      </div>
    </form>

    <div class="stack" style="gap:1rem">
      <div class="panel">
        <div class="panel__head">
          <span class="panel__title"><Icon name="zap" size={14} /> Integrations</span>
          <span class="tiny muted">Server-side only</span>
        </div>
        <div class="panel__body">
          <div class="integration-list">
            {integrations.map((integration) => (
              <div class="integration">
                <div>
                  <span class="integration__name">{integration.name}</span>
                  <div class="tiny muted mono" style="margin-top:0.2rem">{integration.env}</div>
                </div>
                <span class:list={['status-dot', integration.ok ? 'status-dot--ok' : 'status-dot--off']}>
                  {integration.ok ? 'Configured' : 'Missing'}
                </span>
              </div>
            ))}
          </div>
          <p class="tiny muted" style="margin-top:0.85rem;line-height:1.6">
            Missing integrations degrade gracefully. Captures are preserved, listings stay editable, and public pages show an
            honest configuration notice instead of fabricated data. Values are read from Cloudflare runtime bindings and
            are never exposed to the client.
          </p>
        </div>
      </div>

      <div class="panel">
        <div class="panel__head">
          <span class="panel__title"><Icon name="shield" size={14} /> Source retention</span>
        </div>
        <div class="panel__body">
          <p class="tiny muted" style="line-height:1.6">
            Raw post text is never shown publicly. This clears raw text and stored extraction payloads from captures
            older than the saved retention period. Listing fields that were already reviewed are not changed.
          </p>
          <div class="cluster" style="margin-top:0.85rem">
            <button class="btn btn--outline btn--sm" type="button" data-purge-captures>
              <Icon name="trash" size={13} /> Purge expired source text
            </button>
          </div>
          <div class="alert alert--success" data-purge-status role="status" aria-live="polite" hidden style="margin-top:0.85rem"></div>
          <div class="alert alert--error" data-purge-error role="alert" hidden style="margin-top:0.85rem"></div>
        </div>
      </div>

      <div class="panel">
        <div class="panel__head">
          <span class="panel__title"><Icon name="shield" size={14} /> Setup checklist</span>
        </div>
        <div class="panel__body">
          <div class="stack-sm">
            {setupChecks.map((check) => (
              <div class="cluster" style="justify-content:space-between">
                <span class="tiny" style="color:var(--text-dim)">{check.label}</span>
                <span class:list={['status-dot', check.done ? 'status-dot--ok' : 'status-dot--off']}>
                  {check.done ? 'Done' : 'Pending'}
                </span>
              </div>
            ))}
          </div>
          <div class="notice" style="margin-top:0.85rem">
            <strong>No public signup.</strong> Create admin users in Supabase Auth, then insert a matching row in
            <code> admin_profiles</code>. A Supabase user without an active profile is rejected by the server.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel" style="margin-top:1.5rem">
    <div class="panel__head">
      <span class="panel__title"><Icon name="telegram" size={14} /> Telegram webhook</span>
      <span class:list={['badge', config.telegram ? 'badge--approved' : 'badge--draft']}>
        {config.telegram ? 'Ready' : 'Not configured'}
      </span>
    </div>
    <div class="panel__body">
      <p class="small muted" style="line-height:1.6">
        The bot uses the official Telegram Bot API with a secret-token header, an update-ID dedupe table and a user-ID
        allowlist. Register the webhook after setting the environment variables and deploying the site.
      </p>
      <div class="meta-list" style="margin-top:0.85rem">
        <div class="meta-list__row">
          <span class="meta-list__key">Webhook URL</span>
          <span class="meta-list__val mono tiny">{config.siteUrl.replace(/\/+$/, '')}/api/telegram/webhook</span>
        </div>
        <div class="meta-list__row">
          <span class="meta-list__key">Allowed updates</span>
          <span class="meta-list__val mono tiny">message, callback_query</span>
        </div>
      </div>

      <div class="cluster" style="margin-top:1rem">
        <button class="btn btn--primary btn--sm" type="button" data-telegram-register disabled={!config.telegram}>
          <Icon name="telegram" size={13} /> Register webhook
        </button>
        <button class="btn btn--outline btn--sm" type="button" data-telegram-info disabled={!config.telegram}>
          <Icon name="refresh" size={13} /> Check status
        </button>
      </div>
      <pre class="code-block tiny" data-telegram-output hidden style="margin-top:0.85rem;white-space:pre-wrap"></pre>
      <div class="alert alert--error" data-telegram-error role="alert" hidden style="margin-top:0.85rem"></div>
      {!config.telegram && (
        <div class="alert alert--warning" role="status" style="margin-top:0.85rem">
          Set <code>TELEGRAM_BOT_TOKEN</code>, <code>TELEGRAM_WEBHOOK_SECRET</code> and
          <code>TELEGRAM_ADMIN_USER_IDS</code>, then redeploy before registering.
        </div>
      )}
    </div>
  </div>

  <div class="panel" style="margin-top:1.5rem">
    <div class="panel__head">
      <span class="panel__title"><Icon name="telegram" size={14} /> Portfolio control bot webhook</span>
      <span class:list={['badge', config.portfolioControlBot ? 'badge--approved' : 'badge--draft']}>
        {config.portfolioControlBot ? 'Ready' : 'Not configured'}
      </span>
    </div>
    <div class="panel__body">
      <p class="small muted" style="line-height:1.6">This is a separate bot. It does not replace or change the LinkedIn intake webhook.</p>
      <div class="meta-list" style="margin-top:0.85rem">
        <div class="meta-list__row"><span class="meta-list__key">Webhook URL</span><span class="meta-list__val mono tiny">{config.siteUrl.replace(/\/+$/, '')}/api/telegram/portfolio-webhook</span></div>
        <div class="meta-list__row"><span class="meta-list__key">Allowed updates</span><span class="meta-list__val mono tiny">message, callback_query</span></div>
      </div>
      <div class="cluster" style="margin-top:1rem">
        <button class="btn btn--primary btn--sm" type="button" data-portfolio-telegram-register disabled={!config.portfolioControlBot}><Icon name="telegram" size={13} /> Register portfolio webhook</button>
        <button class="btn btn--outline btn--sm" type="button" data-portfolio-telegram-info disabled={!config.portfolioControlBot}><Icon name="refresh" size={13} /> Check status</button>
      </div>
      <pre class="code-block tiny" data-portfolio-telegram-output hidden style="margin-top:0.85rem;white-space:pre-wrap"></pre>
      <div class="alert alert--error" data-portfolio-telegram-error role="alert" hidden style="margin-top:0.85rem"></div>
      {!config.portfolioControlBot && <div class="alert alert--warning" role="status" style="margin-top:0.85rem">Set <code>PORTFOLIO_TELEGRAM_BOT_TOKEN</code>, <code>PORTFOLIO_TELEGRAM_CHAT_ID</code> and <code>PORTFOLIO_TELEGRAM_WEBHOOK_SECRET</code> before registering.</div>}
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-settings-form]');
  const submit = document.querySelector<HTMLButtonElement>('[data-settings-submit]');
  const statusBox = document.querySelector<HTMLElement>('[data-settings-status]');
  const errorBox = document.querySelector<HTMLElement>('[data-settings-error]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;
    const data = new FormData(form);
    const payload = {
      verification_reminder_days: Number(data.get('verification_reminder_days') ?? 14),
      source_retention_days: Number(data.get('source_retention_days') ?? 90),
      public_submissions_enabled: data.get('public_submissions_enabled') === 'on',
      reports_enabled: data.get('reports_enabled') === 'on',
      ai_provider: String(data.get('ai_provider') ?? 'groq'),
      default_currency: String(data.get('default_currency') ?? 'INR'),
    };

    submit?.setAttribute('disabled', 'true');
    if (statusBox) statusBox.hidden = true;
    if (errorBox) errorBox.hidden = true;

    try {
      const response = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
      if (!response.ok || !result?.ok) {
        if (errorBox) {
          errorBox.hidden = false;
          errorBox.textContent = result?.error ?? 'The settings could not be saved.';
        }
        submit?.removeAttribute('disabled');
        return;
      }
      if (statusBox) {
        statusBox.hidden = false;
        statusBox.textContent = 'Settings saved.';
      }
      submit?.removeAttribute('disabled');
    } catch {
      if (errorBox) {
        errorBox.hidden = false;
        errorBox.textContent = 'Network error. Nothing was saved.';
      }
      submit?.removeAttribute('disabled');
    }
  });

  const output = document.querySelector<HTMLElement>('[data-telegram-output]');
  const telegramError = document.querySelector<HTMLElement>('[data-telegram-error]');

  async function telegram(method: 'GET' | 'POST') {
    if (output) {
      output.hidden = false;
      output.textContent = method === 'POST' ? 'Registering webhook…' : 'Fetching webhook info…';
    }
    if (telegramError) telegramError.hidden = true;
    try {
      const response = await fetch('/api/admin/telegram/webhook', { method });
      const result = (await response.json().catch(() => null)) as Record<string, unknown> | null;
      if (!response.ok) {
        if (telegramError) {
          telegramError.hidden = false;
          telegramError.textContent = String((result as { error?: string } | null)?.error ?? 'Telegram request failed.');
        }
        if (output) output.hidden = true;
        return;
      }
      if (output) output.textContent = JSON.stringify(result, null, 2);
    } catch {
      if (output) output.hidden = true;
      if (telegramError) {
        telegramError.hidden = false;
        telegramError.textContent = 'Network error. The webhook was not changed.';
      }
    }
  }

  document.querySelector('[data-telegram-register]')?.addEventListener('click', () => {
    if (window.confirm('Register the Telegram webhook for this site URL?')) void telegram('POST');
  });
  document.querySelector('[data-telegram-info]')?.addEventListener('click', () => void telegram('GET'));

  const portfolioOutput = document.querySelector<HTMLElement>('[data-portfolio-telegram-output]');
  const portfolioError = document.querySelector<HTMLElement>('[data-portfolio-telegram-error]');
  async function portfolioTelegram(method: 'GET' | 'POST') {
    if (portfolioOutput) { portfolioOutput.hidden = false; portfolioOutput.textContent = method === 'POST' ? 'Registering portfolio webhook…' : 'Fetching portfolio webhook info…'; }
    if (portfolioError) portfolioError.hidden = true;
    try {
      const response = await fetch('/api/admin/telegram/portfolio-webhook', { method });
      const result = await response.json().catch(() => null) as Record<string, unknown> | null;
      if (!response.ok) {
        if (portfolioError) { portfolioError.hidden = false; portfolioError.textContent = String(result?.error ?? 'Telegram request failed.'); }
        if (portfolioOutput) portfolioOutput.hidden = true;
        return;
      }
      if (portfolioOutput) portfolioOutput.textContent = JSON.stringify(result, null, 2);
    } catch {
      if (portfolioOutput) portfolioOutput.hidden = true;
      if (portfolioError) { portfolioError.hidden = false; portfolioError.textContent = 'Network error. The webhook was not changed.'; }
    }
  }
  document.querySelector('[data-portfolio-telegram-register]')?.addEventListener('click', () => {
    if (window.confirm('Register the separate portfolio control bot webhook?')) void portfolioTelegram('POST');
  });
  document.querySelector('[data-portfolio-telegram-info]')?.addEventListener('click', () => void portfolioTelegram('GET'));

  const purgeButton = document.querySelector<HTMLButtonElement>('[data-purge-captures]');
  const purgeStatus = document.querySelector<HTMLElement>('[data-purge-status]');
  const purgeError = document.querySelector<HTMLElement>('[data-purge-error]');

  purgeButton?.addEventListener('click', async () => {
    if (!window.confirm('Clear raw source text from captures older than the saved retention period?')) return;
    purgeButton.setAttribute('disabled', 'true');
    if (purgeStatus) purgeStatus.hidden = true;
    if (purgeError) purgeError.hidden = true;
    try {
      const response = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ action: 'purge_source_text' }),
      });
      const result = (await response.json().catch(() => null)) as
        | { ok?: boolean; purged?: number; retention_days?: number; error?: string }
        | null;
      if (!response.ok || !result?.ok) {
        if (purgeError) {
          purgeError.hidden = false;
          purgeError.textContent = result?.error ?? 'The purge could not be completed.';
        }
        purgeButton.removeAttribute('disabled');
        return;
      }
      if (purgeStatus) {
        purgeStatus.hidden = false;
        purgeStatus.textContent = `${result.purged ?? 0} capture(s) older than ${result.retention_days ?? 0} days cleared.`;
      }
      purgeButton.removeAttribute('disabled');
    } catch {
      if (purgeError) {
        purgeError.hidden = false;
        purgeError.textContent = 'Network error. Nothing was cleared.';
      }
      purgeButton.removeAttribute('disabled');
    }
  });
</script>
