# =============================================================================
# Hustler Community Opportunities — environment template
# Copy to .env for local development. Never commit a real .env.
# On Vercel set the same keys under Project Settings → Environment Variables.
# =============================================================================

# --- Application ---
PUBLIC_SITE_URL=http://localhost:4321
NODE_ENV=development

# --- Supabase (Project Settings → API) ---
# Used only server-side for password sign-in and token refresh.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role. Server-only. Never expose this to the browser or Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq AI extraction (server-side only) ----------
AI_PROVIDER=groq
# Groq API key. Get from https://groq.com/console
GROQ_API_KEY=
# Groq model. Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram Bot (server-side only) ---------------
# Create a bot with @BotFather and add it to your group/chat.
TELEGRAM_BOT_TOKEN=
# Webhook secret (arbitrary string known only to this bot and your server).
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated list of allowed Telegram user IDs (admin only).
TELEGRAM_ADMIN_USER_IDS=

# --- LinkedIn retrieval (server-side only) --------------------------------
# The public JSON-LD adapter is DISABLED by default. Enable it only after you
# have legal/contractual authorisation to retrieve LinkedIn post pages.
# Both flags must be "true" for any network retrieval to run.
LINKEDIN_JSONLD_RETRIEVAL_ENABLED=false
LINKEDIN_RETRIEVAL_AUTHORISED=false

# --- Recovery cron (server-side only) -------------------------------------
# Bearer secret used by /api/cron/retry-retrievals. Vercel Cron sends it
# automatically when this variable is set on the project. Leave empty to keep
# the endpoint disabled.
CRON_SECRET=

# --- CAPTCHA / Turnstile (optional, for public submissions) ---
# Get from https://developers.cloudflare.com/turnstone/get-started/
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional testing overrides (E2E) ---
# These are NOT required for normal operation.
E2E_SUPABASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TELEGRAM_SECRET=
