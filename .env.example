# =============================================================================
# Hustler Community Opportunities — environment template
# Copy to .env for local development. Never commit a real .env.
# On Cloudflare Pages set the same keys under Settings → Environment variables.
# =============================================================================

# Canonical public origin. Used for canonical tags, share links, sitemap,
# Telegram previews and admin review links. No trailing slash required.
PUBLIC_SITE_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# Supabase (Project Settings → API)
# -----------------------------------------------------------------------------
SUPABASE_URL=
# Used only server-side for password sign-in and token refresh.
SUPABASE_ANON_KEY=
# Service role. Server-only. Never expose this to the browser or Git.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Gemini extraction (server-side only)
# -----------------------------------------------------------------------------
# Set AI_PROVIDER=none to disable extraction explicitly.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Telegram capture bot (official Bot API)
# -----------------------------------------------------------------------------
# Token from @BotFather. Server-only.
TELEGRAM_BOT_TOKEN=
# Random string sent as X-Telegram-Bot-Api-Secret-Token by Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Send /id to the bot to discover your numeric ID.
TELEGRAM_ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (optional, recommended for public forms)
# -----------------------------------------------------------------------------
# The site key is public by design; the secret key is server-only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Optional: local E2E workflows (A–H). Not used by the app at runtime.
# -----------------------------------------------------------------------------
# E2E_BASE_URL=http://127.0.0.1:4321
# E2E_SUPABASE_URL=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_GEMINI_CONFIGURED=0
# E2E_TELEGRAM_SECRET=
