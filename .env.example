# =============================================================================
# Hustler Community Opportunities — environment template
# Copy to .env for local development. Never commit a real .env.
# On Vercel set the same keys under Project Settings → Environment Variables.
# =============================================================================

# --- Application ---
PUBLIC_SITE_URL=http://localhost:4321
NODE_ENV=development

# --- Supabase (Project Settings → API) ---
# Used only server-side for password sign-in and token refresh.
# The anon key is preferred; if it is omitted, the server falls back to the
# service-role key for GoTrue sign-in only (user sessions still carry the normal
# authenticated role).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role. Server-only. Never expose this to the browser or Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI extraction (server-side only) ---------------
# groq (default), gemini, or none.
AI_PROVIDER=groq
# Groq API key. Get from https://console.groq.com/keys
GROQ_API_KEY=
# Optional fallback credentials. Quota/timeout failures rotate automatically.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Groq model. Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
# Optional alternative provider. Only used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram Bot (server-side only) ---------------
# Create a bot with @BotFather and add it to your group/chat.
TELEGRAM_BOT_TOKEN=
# Webhook secret (arbitrary string known only to this bot and your server).
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated list of allowed Telegram user IDs (admin only).
TELEGRAM_ADMIN_USER_IDS=

# Separate portfolio control and LinkedIn-draft delivery bot.
# Use a fresh BotFather token; do not reuse the LinkedIn intake bot token.
PORTFOLIO_TELEGRAM_BOT_TOKEN=
PORTFOLIO_TELEGRAM_CHAT_ID=
# Random 32+ character secret using letters, digits, underscore or hyphen.
PORTFOLIO_TELEGRAM_WEBHOOK_SECRET=
# Number of LinkedIn drafts delivered per batch (10-30; default 15).
LINKEDIN_DELIVERY_BATCH_SIZE=15

# Optional, owner-authorized Getro integration for EF, Techstars, a16z, and Accel.
# Request access from each board/network owner. JSON maps source IDs to network IDs.
PORTFOLIO_GETRO_API_KEY=
PORTFOLIO_GETRO_NETWORK_IDS={}
# New Getro candidates require a separate owner-authorized key and network ID
# for each source; one source's access is never assumed to cover another.
# Example shape (leave empty until each network owner authorizes access):
# PORTFOLIO_GETRO_SOURCE_CREDENTIALS={"atomico":{"apiKey":"...","networkId":123}}
PORTFOLIO_GETRO_SOURCE_CREDENTIALS={}

# --- LinkedIn retrieval (server-side only) --------------------------------
# The public JSON-LD adapter is DISABLED by default. Enable it only after you
# have legal/contractual authorisation to retrieve LinkedIn post pages.
# Both flags must be "true" for any network retrieval to run.
LINKEDIN_JSONLD_RETRIEVAL_ENABLED=false
LINKEDIN_RETRIEVAL_AUTHORISED=false

# --- Recovery cron (server-side only) -------------------------------------
# Bearer secret used by /api/cron/retry-retrievals. Vercel Cron sends it
# automatically when this variable is set on the project. Leave empty to keep
# the endpoint disabled.
CRON_SECRET=

# --- CAPTCHA / Turnstile (optional, for public submissions) ---
# Get from https://developers.cloudflare.com/turnstile/get-started/
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Candidate email verification (Resend free tier; requires a verified sender domain) ---
# Keep within the provider's free quota; paid-plan overages must remain disabled.
RESEND_API_KEY=
CANDIDATE_EMAIL_FROM=
# Generate a random server-only value with at least 32 bytes of entropy.
CANDIDATE_EMAIL_OTP_SECRET=

# --- Optional testing overrides (E2E) ---
# These are NOT required for normal operation.
E2E_SUPABASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TELEGRAM_SECRET=
# Set to 1 only when the target deployment has a working AI provider.
E2E_AI_CONFIGURED=
